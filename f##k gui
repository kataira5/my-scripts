    local function pickAimTarget(far)
        local char = player.Character; if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart"); if not root then return nil end
        local best, bestDist = nil, far and -1 or math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local d = (hrp.Position - root.Position).Magnitude
                    if far then
                        if d > bestDist then bestDist = d; best = p end
                    else
                        if d < bestDist then bestDist = d; best = p end
                    end
                end
            end
        end
        return best
    end

    local function startAim(far)
        stopAim()
        aimConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if not cam then return end
            if not aimTarget or not aimTarget.Parent or not aimTarget.Character then
                aimTarget = pickAimTarget(far)
            else
                local hum = aimTarget.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then aimTarget = pickAimTarget(far) end
            end
            if not aimTarget or not aimTarget.Character then return end
            local head = aimTarget.Character:FindFirstChild("Head") or aimTarget.Character:FindFirstChild("HumanoidRootPart")
            if not head then return end
            cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)
        end)
    end

