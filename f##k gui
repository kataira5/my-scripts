local function applyVelocity(rootPart, power, duration)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "DashVelocity"
    local look = rootPart.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude > 0 then look = look.Unit end
    bv.Velocity = look * power
    bv.MaxForce = Vector3.new(100000, 0, 100000)
    bv.Parent = rootPart
    if duration and duration > 0 then
        task.delay(duration, function() if bv and bv.Parent then bv:Destroy() end end)
    end
    return bv
end

local function playAnimation(humanoid, animId, stopAfter)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    local track = animator:LoadAnimation(anim)
    track:Play()
    if stopAfter and stopAfter > 0 then
        task.delay(stopAfter, function() if track then track:Stop() end end)
    end
    return track
end

local function updateESPState(key, enabled, getTargets)
    if espConns[key] then espConns[key]:Disconnect() espConns[key] = nil end
    if espHighlights[key] then
        for _, hl in pairs(espHighlights[key]) do if hl and hl.Parent then hl:Destroy() end end
        espHighlights[key] = {}
    end
    if enabled then
        espHighlights[key] = {}
        espConns[key] = RunService.RenderStepped:Connect(function()
            local color = Color3.fromHSV((tick() % 5) / 5, 1, 1)
            local targets = getTargets()
            for _, char in ipairs(targets) do
                if not espHighlights[key][char] or not espHighlights[key][char].Parent then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = color; hl.OutlineColor = color; hl.Parent = char
                    espHighlights[key][char] = hl
                else
                    espHighlights[key][char].FillColor = color
                    espHighlights[key][char].OutlineColor = color
                end
            end
            for char, hl in pairs(espHighlights[key]) do
                if not char.Parent or not table.find(targets, char) then
                    if hl and hl.Parent then hl:Destroy() end
                    espHighlights[key][char] = nil
                end
            end
        end)
    end
end

local function forceReloadAnimate(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local oldAnimator = hum:FindFirstChildOfClass("Animator")
    if oldAnimator then
        for _, track in ipairs(oldAnimator:GetPlayingAnimationTracks()) do
            pcall(function() track:Stop() end)
        end
        pcall(function() oldAnimator:Destroy() end)
    end
    local oldAnimate = char:FindFirstChild("Animate")
    local clonedAnimate = nil
    if oldAnimate then
        clonedAnimate = oldAnimate:Clone()
        oldAnimate:Destroy()
    end
    task.wait(0.2)
    local newAnimator = Instance.new("Animator")
    newAnimator.Parent = hum
    if clonedAnimate then
        clonedAnimate.Parent = char
    end
    task.wait(0.15)
    if hum.MoveDirection.Magnitude > 0.1 then
        hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
        task.wait(0.05)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

local function restoreAnimState(savedData, animate, hum)
    if not savedData or not animate then return end
    if hum then hum.WalkSpeed = savedData.walkSpeed or 16 end
    if savedData.idle1 and animate.idle and animate.idle:FindFirstChild("Animation1") then animate.idle.Animation1.AnimationId = savedData.idle1 end
    if savedData.idle2 and animate.idle and animate.idle:FindFirstChild("Animation2") then animate.idle.Animation2.AnimationId = savedData.idle2 end
    if savedData.walkAnim and animate.walk and animate.walk:FindFirstChild("WalkAnim") then animate.walk.WalkAnim.AnimationId = savedData.walkAnim end
    if savedData.runAnim and animate.run and animate.run:FindFirstChild("RunAnim") then animate.run.RunAnim.AnimationId = savedData.runAnim end
    local char = animate.Parent
    forceReloadAnimate(char)
end

