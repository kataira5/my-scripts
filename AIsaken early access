        local delta = input.Position - camTouchLast
        camTouchLast = input.Position
        if freecamEnabled then
            fcYaw = fcYaw - delta.X * 0.005
            fcPitch = math.clamp(fcPitch - delta.Y * 0.005, -1.4, 1.4)
