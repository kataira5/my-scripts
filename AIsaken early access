-- ================= СОХРАНЕНИЕ GUI ПРИ СМЕРТИ =================
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if ScreenGui and not ScreenGui.Parent then
        ScreenGui.Parent = PlayerGui
    end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg and ScreenGui and ScreenGui.Parent ~= pg then
        ScreenGui.Parent = pg
    end
    -- восстанавливаем кнопку Noli после респавна (если была показана)
    if noliBtn and noliBtn.Visible then
        ensureNoliButton()
    end
    -- восстанавливаем мобильные контролы Freecam (если тумблер включён)
    if joyBase and joyBase.Visible then
        ensureFreecamControls()
        if joyBase then joyBase.Visible = true end
        if fcUpBtn then
            fcUpBtn.Visible = true
            fcDownBtn.Visible = true
        end
    end
end)
