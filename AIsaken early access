-- FPS / Ping
local infoFrame = Instance.new("Frame")
if IS_MOBILE then
    infoFrame.Size = UDim2.new(0, 160, 0, 44)
    infoFrame.Position = UDim2.new(1, -170, 0, 60)
else
    infoFrame.Size = UDim2.new(0, 200, 0, 44)
    infoFrame.Position = UDim2.new(1, -210, 0, 10)
end
infoFrame.BackgroundTransparency = 1
infoFrame.Parent = ScreenGui

local fpsLabel = Instance.new("TextLabel")
fpsLabel.Size = UDim2.new(1, 0, 0, 22)
fpsLabel.BackgroundTransparency = 1
fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
fpsLabel.Font = Enum.Font.GothamBold
fpsLabel.TextSize = IS_MOBILE and 16 or 14
fpsLabel.TextXAlignment = Enum.TextXAlignment.Right
fpsLabel.Text = ""
fpsLabel.Parent = infoFrame

local pingLabel = Instance.new("TextLabel")
pingLabel.Size = UDim2.new(1, 0, 0, 22)
pingLabel.Position = UDim2.new(0, 0, 0, 22)
pingLabel.BackgroundTransparency = 1
pingLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
pingLabel.Font = Enum.Font.GothamBold
pingLabel.TextSize = IS_MOBILE and 16 or 14
pingLabel.TextXAlignment = Enum.TextXAlignment.Right
pingLabel.Text = ""
pingLabel.Parent = infoFrame

local fpsEnabled, pingEnabled = false, false
local frames = 0
local lastTime = tick()
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    if tick() - lastTime >= 1 then
        if fpsEnabled then
            fpsLabel.Text = "FPS: " .. frames
            fpsLabel.TextColor3 = frames < 30 and Color3.fromRGB(255, 0, 0)
                or frames < 100 and Color3.fromRGB(255, 165, 0)
                or Color3.fromRGB(0, 255, 0)
        else fpsLabel.Text = "" end
        frames = 0
        lastTime = tick()
    end
    if pingEnabled then
        local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        pingLabel.Text = "Ping: " .. ping
        pingLabel.TextColor3 = ping < 300 and Color3.fromRGB(0, 255, 0)
            or ping < 1000 and Color3.fromRGB(255, 165, 0)
            or Color3.fromRGB(255, 0, 0)
    else pingLabel.Text = "" end
end)

CreateToggle(DefaultPage, "FPS", function(s) fpsEnabled = s end)
CreateToggle(DefaultPage, "Ping", function(s) pingEnabled = s end)

-- ================= НАСТРОЙКИ =================
themeToggle = Instance.new("TextButton")
themeToggle.Size = UDim2.new(1, 0, 0, IS_MOBILE and 52 or 40)
themeToggle.BackgroundColor3 = THEME.Dark.Button
themeToggle.Text = "Dark Theme (ON)"
themeToggle.TextColor3 = THEME.Dark.Text
themeToggle.TextSize = IS_MOBILE and 18 or 14
themeToggle.Font = Enum.Font.GothamBold
themeToggle.Parent = SettingsPage
Instance.new("UICorner", themeToggle).CornerRadius = UDim.new(0, 8)
themeElements[#themeElements + 1] = {obj = themeToggle, kind = "button"}

themeToggle.MouseButton1Click:Connect(function()
    isDarkTheme = not isDarkTheme
    local t = isDarkTheme and THEME.Dark or THEME.Light
    updateThemeToggleText()
    for _, e in ipairs(themeElements) do
        if e.kind == "background" then
            e.obj.BackgroundColor3 = t.Background
        elseif e.kind == "button" then
            e.obj.BackgroundColor3 = t.Button
            if e.obj:IsA("TextButton") or e.obj:IsA("TextLabel") then
                e.obj.TextColor3 = t.Text
            end
        elseif e.kind == "text" then
            e.obj.TextColor3 = t.Text
        end
    end
    MainFrame.BackgroundColor3 = t.Background
    TitleBar.BackgroundColor3 = isDarkTheme and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(180, 180, 180)
    TitleText.TextColor3 = isDarkTheme and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
end)

