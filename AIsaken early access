        local center = joyBase.AbsolutePosition + joyBase.AbsoluteSize / 2
        local offset = input.Position - center
        local maxR = joyBase.AbsoluteSize.X / 2
        if offset.Magnitude > maxR then
            offset = offset.Unit * maxR
        end
        joyKnob.Position = UDim2.new(0.5, offset.X - 25, 0.5, offset.Y - 25)
        joyMove = Vector3.new(offset.X / maxR, 0, offset.Y / maxR)
