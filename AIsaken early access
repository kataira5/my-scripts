    UDim2.new(0.5, IS_MOBILE and -130 or -110, 0.5, IS_MOBILE and -85 or -65))
local aimMode = "none"
local function resetCamera()
    if LocalPlayer.Character then
        workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
end
local function updateCamera()
    if aimMode == "none" then resetCamera() return end
    local closest, farthest
    local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
            if not closest or dist < closest.dist then closest = {plr = plr, dist = dist} end
            if not farthest or dist > farthest.dist then farthest = {plr = plr, dist = dist} end
        end
