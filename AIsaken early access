local function CreateToggle(parent, name, callback, defaultValue)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, IS_MOBILE and 52 or 34)
    container.BackgroundColor3 = THEME.Dark.Button
    container.Parent = parent
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -(IS_MOBILE and 110 or 80), 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = THEME.Dark.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = IS_MOBILE and 16 or 13
    label.Parent = container
    pcall(function()
        registerText(label, name, RU_MAP[name] or name)
    end)

    local toggleBtn = Instance.new("TextButton")
    local btnW, btnH = IS_MOBILE and 64 or 42, IS_MOBILE and 32 or 20
    toggleBtn.Size = UDim2.new(0, btnW, 0, btnH)
    toggleBtn.Position = UDim2.new(1, -(btnW + 8), 0.5, -btnH / 2)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false
    toggleBtn.Parent = container
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    local cSize = IS_MOBILE and 26 or 16
    circle.Size = UDim2.new(0, cSize, 0, cSize)
    circle.Position = UDim2.new(0, 3, 0.5, -cSize / 2)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = toggleBtn
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local state = defaultValue or false
    local function updateVisuals()
        if state then
            TweenService:Create(toggleBtn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(0, 255, 0)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.25),
                {Position = UDim2.new(1, -(cSize + 3), 0.5, -cSize / 2)}):Play()
        else
            TweenService:Create(toggleBtn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(255, 0, 0)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.25),
                {Position = UDim2.new(0, 3, 0.5, -cSize / 2)}):Play()
        end
    end
    updateVisuals()

    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        updateVisuals()
        callback(state)
        setPointerFeedback(state)
    end)

    toggles[name] = {container = container, label = label}
    themeElements[#themeElements + 1] = {obj = container, kind = "button"}
    themeElements[#themeElements + 1] = {obj = label, kind = "text"}
    return container
end

-- ================= ФУНКЦИЯ СОЗДАНИЯ КНОПКИ-ДЕЙСТВИЯ =================
local function CreateActionButton(parent, name, callback, cooldown)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, IS_MOBILE and 52 or 34)
    container.BackgroundColor3 = THEME.Dark.Button
    container.Parent = parent
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 8)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = THEME.Dark.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = IS_MOBILE and 16 or 13
    btn.Parent = container
    pcall(function()
        registerText(btn, name, RU_MAP[name] or name)
    end)

    local cdLabel = Instance.new("TextLabel")
    cdLabel.Size = UDim2.new(0, 60, 1, 0)
    cdLabel.Position = UDim2.new(1, -60, 0, 0)
    cdLabel.BackgroundTransparency = 1
    cdLabel.Text = ""
    cdLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    cdLabel.Font = Enum.Font.GothamBold
    cdLabel.TextSize = IS_MOBILE and 16 or 13
    cdLabel.Parent = container

    local lastUse = 0
    local cd = cooldown or 0

    btn.MouseButton1Click:Connect(function()
        local now = tick()
        if cd > 0 and (now - lastUse) < cd then
            cdLabel.Text = math.ceil(cd - (now - lastUse)) .. "s"
            return
        end
        lastUse = now
        if cd > 0 then
            task.spawn(function()
                for i = cd, 1, -1 do
                    cdLabel.Text = i .. "s"
                    task.wait(1)
                end
                cdLabel.Text = ""
            end)
        end
        callback()
        setPointerFeedback(true)
    end)

    themeElements[#themeElements + 1] = {obj = container, kind = "button"}
    themeElements[#themeElements + 1] = {obj = btn, kind = "text"}
    return container, btn
end

