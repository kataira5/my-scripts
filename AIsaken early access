local function startFreecam()
    if freecamEnabled then return end
    if nccEnabled then setNoclipCamera(false) end
    freecamEnabled = true
    local cam = workspace.CurrentCamera
    freecamCFrame = cam.CFrame
    local look = cam.CFrame.LookVector
    fcPitch = math.asin(math.clamp(look.Y, -1, 1))
    fcYaw = math.atan2(-look.X, -look.Z)
    cam.CameraType = Enum.CameraType.Scriptable
    freecamConn = RunService.RenderStepped:Connect(function(dt)
        local cam = workspace.CurrentCamera
        if not IS_MOBILE then
            local delta = UserInputService:GetMouseDelta()
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                fcYaw = fcYaw - delta.X * 0.005
                fcPitch = math.clamp(fcPitch - delta.Y * 0.005, -1.4, 1.4)
            end
        end
        local rot = CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
        local move = Vector3.zero
        if not IS_MOBILE then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
        else
            move = joyMove
            if fcUpHeld then move += Vector3.new(0, 1, 0) end
            if fcDownHeld then move += Vector3.new(0, -1, 0) end
        end
        if move.Magnitude > 0 then
            local dir = move.Magnitude > 1 and move.Unit or move
            freecamCFrame = freecamCFrame + rot:VectorToWorldSpace(dir) * fcSpeed * dt
        end
        cam.CFrame = rot + freecamCFrame.Position
    end)
end

