local function updateThemeToggleText()
    if not themeToggle then return end
    themeToggle.Text = isRussian
        and ("Тёмная тема (" .. (isDarkTheme and "ВКЛ" or "ВЫКЛ") .. ")")
        or ("Dark Theme (" .. (isDarkTheme and "ON" or "OFF") .. ")")
end

local function registerText(obj, en, ru)
    translatable[obj] = {en = en, ru = ru or RU_MAP[en] or en}
end

local function applyLanguage()
    for obj, t in pairs(translatable) do
        if obj and obj.Parent then
            if obj:IsA("TextBox") then
                obj.PlaceholderText = isRussian and t.ru or t.en
            else
                obj.Text = isRussian and t.ru or t.en
            end
        end
    end
    updateThemeToggleText()
end

